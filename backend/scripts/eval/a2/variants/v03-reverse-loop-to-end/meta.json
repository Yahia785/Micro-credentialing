{
  "id": "v03-reverse-loop-to-end",
  "summary": "reverseList loop runs to vec.size() instead of the middle.",
  "bugs": [
    {
      "function": "reverseList",
      "kind": "loop-bound",
      "description": "Loop goes to vec.size(), so every pair is swapped twice and the vector ends unchanged (size 1 and 0 are fine)."
    }
  ],
  "interview": {
    "reverseList": {
      "tracing": {
        "pauseLine": 6,
        "variables": [
          {
            "name": "left number",
            "expr": "vec[i]"
          },
          {
            "name": "right number",
            "expr": "vec[vec.size() - 1 - i]"
          }
        ]
      },
      "whatIf": {
        "line": 7,
        "find": "vec[vec.size() - 1 - i]",
        "replace": "vec[0]"
      }
    },
    "splitString": {
