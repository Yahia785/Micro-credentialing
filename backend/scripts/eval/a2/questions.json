    "playCraps": {
      "primary": true,
      "templates": [
        {
          "id": "playCraps.predict",
          "type": "predict",
          "question": "What does your playCraps return for {input}?",
          "standardInputs": [
            {
              "cmd": "playCraps 2 2 1 2 3 4",
              "display": "the dice values {2, 2, 1, 2, 3, 4}",
              "spec": "1"
            },
            {
              "cmd": "playCraps 5 6",
              "display": "the dice values {5, 6}",
              "spec": "0"
            },
            {
              "cmd": "playCraps 0 3",
              "display": "the dice values {0, 3}",
              "spec": "-1"
            }
          ],
          "targetInputs": [
            {
              "bug": "v07",
              "cmd": "playCraps 3 4 7 1",
              "display": "the dice values {3, 4, 7, 1}",
              "spec": "-1"
            },
            {
              "bug": "v08",
              "cmd": "playCraps 2 2 1 2",
              "display": "the dice values {2, 2, 1, 2}",
              "spec": "2"
            }
          ]
        },
        {
          "id": "playCraps.whatIf",
          "type": "whatIf",
          "question": "If {change}, what would your playCraps return for {input}?",
          "change": "a first roll that adds up to 11 were no longer an instant win for the player",
          "mutant": "reference/whatif/playCraps-eleven-not-instant-win.cpp",
          "standardInputs": [
            {
              "cmd": "playCraps 5 6",
              "display": "the dice values {5, 6}",
              "spec": "2",
              "changesAnswer": true
            },
            {
              "cmd": "playCraps 5 6 5 6",
              "display": "the dice values {5, 6, 5, 6}",
              "spec": "0",
              "changesAnswer": false
            },
            {
              "cmd": "playCraps 3 4",
              "display": "the dice values {3, 4}",
              "spec": "0",
              "changesAnswer": false
            }
          ],
          "targetInputs": [
            {
              "bug": "v07",
              "cmd": "playCraps 3 4 7 1",
              "display": "the dice values {3, 4, 7, 1}",
              "spec": "-1",
              "changesAnswer": false
            },
            {
              "bug": "v08",
              "cmd": "playCraps 2 2 1 2",
              "display": "the dice values {2, 2, 1, 2}",
              "spec": "2",
              "changesAnswer": false
            }
          ]
        },
        {
          "id": "playCraps.tracing",
          "type": "tracing",
          "question": "If you paused your program at {pausePoint} while running playCraps on {input}, what would {variables} hold the {kth} time it stops?",
          "pausePoint": "the moment the sum of one roll (two dice) has just been worked out",
          "variables": "that sum",
          "trace": "reference/trace/playCraps.cpp",
          "standardInputs": [
            {
              "cmd": "playCraps 2 2 1 2 3 4",
              "display": "the dice values {2, 2, 1, 2, 3, 4}",
              "k": 2,
              "kth": "2nd",
              "stops": 3,
              "spec": "sum=3\r"
            },
            {
              "cmd": "playCraps 5 6",
              "display": "the dice values {5, 6}",
              "k": 1,
              "kth": "1st",
              "stops": 1,
              "spec": "sum=11"
            },
            {
              "cmd": "playCraps 4 4 3 3 6 2",
              "display": "the dice values {4, 4, 3, 3, 6, 2}",
              "k": 3,
              "kth": "3rd",
              "stops": 3,
              "spec": "sum=8"
            }
          ],
          "targetInputs": [
            {
              "bug": "v07",
              "cmd": "playCraps 3 4 7 1",
              "display": "the dice values {3, 4, 7, 1}",
              "k": 1,
              "kth": "1st",
              "stops": 0,
              "spec": "it never stops a 1st time (it stops 0 times)"
            }
          ]
        }
      ]
    },
