              "spec": "[\",\", \"apple,\", \"banana,\", \"orange\"]",
              "changesAnswer": true
            },
            {
              "bug": "v10",
              "cmd": "splitString , a,b,c",
              "display": "the string \"a,b,c\" with delimiter ','",
              "spec": "[\"a,\", \"b,\", \"c\"]",
              "changesAnswer": true
            }
          ]
        },
        {
          "id": "splitString.tracing",
          "type": "tracing",
          "question": "If you paused your program at {pausePoint} while running splitString on {input}, what would {variables} hold the {kth} time it stops?",
          "pausePoint": "the moment a piece has just been added to the result (including the last piece)",
          "variables": "the piece that was just added",
          "trace": "reference/trace/splitString.cpp",
          "standardInputs": [
            {
              "cmd": "splitString , a,b,c",
              "display": "the string \"a,b,c\" with delimiter ','",
              "k": 2,
              "kth": "2nd",
              "stops": 3,
              "spec": "piece=\"b\"\r"
            },
            {
              "cmd": "splitString , ,apple,banana,orange",
              "display": "the string \",apple,banana,orange\" with delimiter ','",
              "k": 1,
              "kth": "1st",
              "stops": 4,
              "spec": "piece=\"\"\r"
            },
            {
              "cmd": "splitString , abc",
              "display": "the string \"abc\" with delimiter ','",
