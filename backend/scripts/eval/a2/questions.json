{
  "version": 1,
  "about": "Question templates for the Assignment 02 pilot (ECE 2514). Every \"spec\" field is filled by run-all.js, by running the reference (predict), a one-line mutant of it (whatIf, see \"mutant\") or an instrumented copy of it (tracing, see \"trace\"). Do not edit spec fields by hand.",
  "placeholders": "{input} = the input's \"display\" text, {kth} = the input's \"kth\" text, {change} / {pausePoint} / {variables} = the template's own fields.",
  "functions": {
    "reverseList": {
      "primary": true,
      "templates": [
        {
          "id": "reverseList.predict",
          "type": "predict",
          "question": "What would the vector hold after your reverseList runs on {input}?",
          "standardInputs": [
            {
              "cmd": "reverseList 10 20 30 40 50",
              "display": "the vector {10, 20, 30, 40, 50}",
              "spec": "[50, 40, 30, 20, 10]"
            },
            {
              "cmd": "reverseList 1 2 3 4",
              "display": "the vector {1, 2, 3, 4}",
              "spec": "[4, 3, 2, 1]"
            },
            {
              "cmd": "reverseList 7",
              "display": "the vector {7}",
              "spec": "[7]"
            }
          ],
          "targetInputs": [
            {
              "bug": "v03",
              "cmd": "reverseList 3 5 8",
              "display": "the vector {3, 5, 8}",
              "spec": "[8, 5, 3]"
            },
            {
              "bug": "v04",
              "cmd": "reverseList",
              "display": "an empty vector",
              "spec": "[]"
            }
          ]
        },
        {
          "id": "reverseList.whatIf",
          "type": "whatIf",
          "question": "If {change}, what would the vector hold after your reverseList runs on {input}?",
          "change": "your loop did one fewer swap than it does now",
          "mutant": "reference/whatif/reverseList-one-fewer-swap.cpp",
          "standardInputs": [
            {
              "cmd": "reverseList 10 20 30 40 50",
              "display": "the vector {10, 20, 30, 40, 50}",
              "spec": "[50, 20, 30, 40, 10]",
              "changesAnswer": true
            },
            {
              "cmd": "reverseList 1 2",
              "display": "the vector {1, 2}",
              "spec": "[1, 2]",
              "changesAnswer": true
            },
            {
              "cmd": "reverseList",
              "display": "an empty vector",
              "spec": "[]",
              "changesAnswer": false
            }
          ],
          "targetInputs": [
            {
              "bug": "v03",
              "cmd": "reverseList 3 5 8",
              "display": "the vector {3, 5, 8}",
              "spec": "[3, 5, 8]",
              "changesAnswer": true
            },
            {
              "bug": "v04",
              "cmd": "reverseList",
              "display": "an empty vector",
              "spec": "[]",
              "changesAnswer": false
            }
          ]
        },
        {
          "id": "reverseList.tracing",
          "type": "tracing",
          "question": "If you paused your program at {pausePoint} while running reverseList on {input}, what would {variables} hold the {kth} time it stops?",
          "pausePoint": "the start of a swap (just before two numbers are exchanged)",
          "variables": "the two positions being swapped (the left one and the right one)",
          "trace": "reference/trace/reverseList.cpp",
          "standardInputs": [
            {
              "cmd": "reverseList 10 20 30 40 50",
              "display": "the vector {10, 20, 30, 40, 50}",
              "k": 2,
              "kth": "2nd",
              "stops": 2,
              "spec": "left=1 right=3"
            },
            {
              "cmd": "reverseList 1 2 3 4",
              "display": "the vector {1, 2, 3, 4}",
              "k": 1,
              "kth": "1st",
              "stops": 2,
              "spec": "left=0 right=3\r"
            },
            {
              "cmd": "reverseList 1 2 3 4 5 6",
              "display": "the vector {1, 2, 3, 4, 5, 6}",
              "k": 3,
              "kth": "3rd",
              "stops": 3,
              "spec": "left=2 right=3"
            }
          ],
          "targetInputs": [
            {
              "bug": "v03",
              "cmd": "reverseList 1 2 3 4",
              "display": "the vector {1, 2, 3, 4}",
              "k": 3,
              "kth": "3rd",
              "stops": 2,
              "spec": "it never stops a 3rd time (it stops 2 times)"
            },
            {
              "bug": "v04",
              "cmd": "reverseList",
              "display": "an empty vector",
              "k": 1,
              "kth": "1st",
              "stops": 0,
              "spec": "it never stops a 1st time (it stops 0 times)"
            }
          ]
        }
      ]
    },
    "splitString": {
